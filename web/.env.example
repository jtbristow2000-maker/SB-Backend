# App
NODE_ENV=development
SANDBOX_MODE=true
APP_BASE_URL=http://localhost:3000
# Public URL used for webhook signature validation behind Vercel/tunnels.
PUBLIC_BASE_URL=
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
API_KEY=
PERSISTENCE=memory

# Single-tenant business bootstrap
BUSINESS_ID=
BUSINESS_NAME=
OWNER_NAME=
OWNER_PHONE=
BUSINESS_PHONE=
TIMEZONE=America/New_York

# Supabase persistence/auth
# PERSISTENCE=memory keeps the local demo and tests fully in-memory.
# PERSISTENCE=supabase requires SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (future voice/SMS webhooks; no sending enabled)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_AUTO_PROVISION=false
TWILIO_DEFAULT_AREA_CODE=
WEBHOOK_SIGNATURE_REQUIRED=false

# Optional observability
SENTRY_DSN=

# Internal jobs
# For Vercel Cron, set CRON_SECRET in Vercel and set INTERNAL_JOB_TOKEN to the same value.
# Vercel sends Authorization: Bearer $CRON_SECRET on scheduled GET requests.
CRON_SECRET=
INTERNAL_JOB_TOKEN=
FOLLOW_UP_STALE_HOURS=24

# AI/transcription (disabled by default)
OPENAI_API_KEY=
FAST_TRANSCRIPTION_ENABLED=false
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_EXTRACTION_ENABLED=false
# EXTRACTION_PROVIDER=openai|anthropic; blank prefers Anthropic when configured, then OpenAI.
EXTRACTION_PROVIDER=
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
# Optional OpenAI model for AI missed-call reply generation.
OPENAI_REPLY_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Safety flags
SMS_SENDING_ENABLED=false
CALL_FORWARDING_ENABLED=false
REAL_MESSAGE_SENDING_ENABLED=false
REAL_CALL_AUTOMATION_ENABLED=false
