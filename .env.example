# App
APP_ENV=development
SANDBOX_MODE=true
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=sqlite://./data/dev.db

# Safety flags
REAL_MESSAGE_SENDING_ENABLED=false
REAL_CALL_AUTOMATION_ENABLED=false

# Business defaults for local testing
DEFAULT_BUSINESS_NAME=
DEFAULT_OWNER_NAME=
DEFAULT_OWNER_PHONE=
DEFAULT_BUSINESS_PHONE=
DEFAULT_TIMEZONE=America/New_York

# Call/SMS provider
CALL_PROVIDER=sandbox
SMS_PROVIDER=sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Transcription
TRANSCRIPTION_PROVIDER=sandbox
OPENAI_API_KEY=

# AI extraction
AI_EXTRACTION_PROVIDER=sandbox
ANTHROPIC_API_KEY=

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./data/uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
